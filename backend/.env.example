# Environment Variables Template — Copy to .env and fill values

# ═══════════════════════════════════════════════════
# LLM PROVIDERS
# ═══════════════════════════════════════════════════
# Leave empty for Cursor RAG file agent (no cloud API). Paste real keys only if using Gemini/OpenAI.
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
PRIMARY_LLM=gemini                # gemini | openai
FAST_LLM=gemini-flash             # gemini-flash | gpt-4o-mini

# Local LLM (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_ENABLED=false

# RAG file agent — Cursor reads rag_query.txt, writes rag_response.txt (see SETUP_GUIDE.md)
RAG_FILE_AGENT_ENABLED=true
RAG_FILE_AGENT_ONLY=true
RAG_FILE_TIMEOUT_SECONDS=300
RAG_FILE_RETRY_TIMEOUT_SECONDS=90
RAG_FILE_SLOT_REGEN_TIMEOUT_SECONDS=120
RAG_FILE_POLL_INTERVAL_SECONDS=0.2
RAG_FILE_MAX_RETRIES=6

# ═══════════════════════════════════════════════════
# VECTOR STORE — FAISS (default, no Docker)
# Set VECTOR_STORE_BACKEND=qdrant + run docker Qdrant to use Qdrant instead
# ═══════════════════════════════════════════════════
VECTOR_STORE_BACKEND=faiss
FAISS_DATA_PATH=./data/faiss
EMBEDDING_DIMENSION=384
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_QUESTIONS=questions
QDRANT_COLLECTION_HISTORY=generation_history
QDRANT_COLLECTION_DOCUMENTS=documents

# ═══════════════════════════════════════════════════
# DATABASE — SQLite (default, no Docker)
# For Postgres: postgresql+asyncpg://user:pass@localhost:5433/assessment_db
# ═══════════════════════════════════════════════════
DATABASE_URL=sqlite+aiosqlite:///./data/assessment.db
DATABASE_SYNC_URL=sqlite:///./data/assessment.db

# ═══════════════════════════════════════════════════
# STORAGE (Local or S3)
# ═══════════════════════════════════════════════════
STORAGE_BACKEND=local             # local | s3
LOCAL_STORAGE_PATH=./uploads

# PDF export quality (higher = sharper figures in downloaded PDF)
FIGURE_EXPORT_DPI=300
FIGURE_POINT_LABEL_FONT_PT=17
FIGURE_SEGMENT_LABEL_FONT_PT=12
FIGURE_TITLE_FONT_PT=14
FIGURE_POINT_MARKER_SIZE=10
PDF_FIGURE_WIDTH_MM=88
PDF_FIGURE_HEIGHT_MM=72
AWS_S3_BUCKET=assessment-engine
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ═══════════════════════════════════════════════════
# AUTH
# ═══════════════════════════════════════════════════
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ═══════════════════════════════════════════════════
# APP SETTINGS
# ═══════════════════════════════════════════════════
APP_NAME=Assessment Engine
APP_ENV=development               # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ═══════════════════════════════════════════════════
# GENERATION SETTINGS
# ═══════════════════════════════════════════════════
DEDUP_SIMILARITY_THRESHOLD=0.92
DEDUP_BATCH_SIMILARITY_THRESHOLD=0.90
DEDUP_MAX_REGEN_ATTEMPTS=2
QUALITY_REGEN_ENABLED=true
QUALITY_REGEN_USE_CURSOR=true
QUALITY_REGEN_MAX_PER_SLOT=4
MAX_CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_RETRIEVAL_CHUNKS=6
MAX_INGEST_PAGES=0
ENABLE_INGEST_OCR=false
INGEST_EMBED_BATCH_SIZE=32
ENABLE_PROMPT_SECTION_DOMINANCE=true
PROMPT_SECTION_DOMINANCE_STRICT=true
PROMPT_FOREIGN_TOPIC_RATIO_MAX=0.10
ENABLE_HARDNESS_SCORER=true
ENABLE_EXAMINER_SIMULATION=true
ENABLE_STEM_DEPENDENCY_VALIDATION=true
ENABLE_FIGURE_NECESSITY_VALIDATION=true
ENABLE_REJECTION_CORPUS=true
REJECTION_CORPUS_LIMIT=40
REJECTION_CORPUS_PROMPT_MAX_EXAMPLES=8

ENABLE_FIGURE_GENERATION=true
ENABLE_SELF_ENHANCEMENT=true
MAX_QUESTIONS_PER_GENERATION=100
MULTI_AGENT_ORCHESTRATION=true
TOPIC_GATE_LENIENT_FALLBACK=true
RETRIEVAL_CONFIDENCE_THRESHOLD=0.45
RETRIEVAL_MIN_CHUNKS=2
RETRIEVAL_MIN_MEAN_SCORE=0.35
TOPIC_ALIGNMENT_ACCEPT_THRESHOLD=0.55
TOPIC_ALIGNMENT_REJECT_THRESHOLD=0.35
MAX_SAME_THEOREM_RATIO=0.4
MINIMUM_THEOREM_COVERAGE_SCORE=0.5
THEOREM_COVERAGE_ENFORCE=true
MINIMUM_WEIGHTED_COVERAGE_SCORE=0.55
MINIMUM_COGNITIVE_DIVERSITY_SCORE=0.4
CONTROLLED_ORGANIC_NOISE=0.15
GENERATION_MEMORY_LIMIT=80
ENABLE_GENERATION_MEMORY=true
ENABLE_STUDENT_SKILL_TARGETING=true
# Paper layout: auto | chained_concentric | mixed_independent | chained_triangle
DEFAULT_PAPER_TEMPLATE=auto
SOLUTION_ELEGANCE_WEIGHT=0.12
ENABLE_SEMANTIC_PROMPT_PURITY=true
SEMANTIC_PURITY_MARGIN=0.04
SEMANTIC_PURITY_MIN_LOCKED_SIM=0.22
