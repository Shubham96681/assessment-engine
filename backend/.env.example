NODE_ENV=development
PORT=3000
APP_NAME=Assessment Engine
APP_URL=http://localhost:3000
API_URL=http://localhost:3000

DATABASE_URL=file:./dev.db

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Set to true when you do not run Redis locally (no Bull queues; rate limits use memory).
REDIS_DISABLED=false

JWT_SECRET=change-me-access-secret-min-32-chars-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@example.com

LOG_LEVEL=info

RUN_MIGRATIONS_ON_BOOT=false

# Dev only: skip JWT + role checks on API routes; impersonate AUTH_DISABLED_AS_USER (must exist after seed). Never use in production.
# AUTH_DISABLED=true
# AUTH_DISABLED_AS_USER=teacher@demo-school.test

# Optional: absolute path to unpacked CBSE curriculum folder (class/subject/… PDFs). Used by POST /api/v1/resources/books/import-local-cbse and extraction from disk.
# LOCAL_CBSE_LIBRARY_ROOT=C:/path/to/CBSE

# Login: if the client omits password, the API uses this value (must match seeded hash when using prisma seed).
AUTH_DEFAULT_PASSWORD=Password123!
